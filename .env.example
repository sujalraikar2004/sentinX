# Optional: enables evidence-based Gemini explanations. Keep this key server-side.
GEMINI_API_KEY=

# Optional local inference service (see ml-service/README.md).
# Leave blank to use heuristic fallback analysis.
VOICE_DETECTOR_API_URL=
DEEPFAKE_DETECTOR_API_URL=

# Optional server port (defaults to 3000).
PORT=3000
