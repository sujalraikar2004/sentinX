# Public Hugging Face checkpoints; no API key is needed for these models.
AUDIO_MODEL_ID=Hemgg/Deepfake-audio-detection
AUDIO_FAKE_LABELS=AIVoice
IMAGE_MODEL_ID=dima806/deepfake_vs_real_image_detection

# If model downloads stall at 0%, try the standard HTTPS transfer path and longer timeout.
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
